@model YeniKitapKirtasiyeWebApp.Models.Product
@{
    ViewBag.Title = "Find";
    Layout = "~/Views/Shared/_UserLayoutPage.cshtml";
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "UserHome")">Anasayfa</a>
    <div class="breadcrumb-sep">›</div>
    <a href="@Url.Action("Index", "UserProduct", new { kategoriID = Model.Category_ID })">
        @Model.category.Name
    </a>
    <div class="breadcrumb-sep">›</div>
    <div>@Model.Name</div>
</div>

<div class="detay-wrapper">

    <div class="detay-fotograf">
        <img src="~/Assets/ProductImages/@Model.ImagePath"
             alt="@Model.Name" />
    </div>

    <div class="detay-bilgi">
        <div class="detay-kategori">@Model.category.Name</div>
        <div class="detay-isim">@Model.Name</div>
        <div class="detay-fiyat">@Model.Price.ToString("C")</div>

        <hr class="detay-separator" />

        <div class="detay-aciklama">@Model.Description</div>

        @if (Model.Stock > 0)
        {
            <div class="stok-badge">Stokta Var</div>
        }
        else
        {
            <div class="stok-badge yok">Stokta Yok</div>
        }

        <div style="display:flex; flex-direction:column; gap:10px; align-items:flex-start;">
            @if (Session["UserName"] != null)
            {
                <a href="@Url.Action("SepeteEkle", "UserProduct", new { id = Model.ID })"
                   class="sepet-btn">
                    Sepete Ekle
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "UserAccount")" class="sepet-btn sepet-btn-disabled">
                    Sepete Eklemek İçin Giriş Yap
                </a>
            }
        </div>
    </div>

</div>

