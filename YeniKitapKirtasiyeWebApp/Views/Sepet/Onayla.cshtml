@model IEnumerable<YeniKitapKirtasiyeWebApp.Data.ViewModel.SepetItem>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/Assets/Css/UserPanel.css" rel="stylesheet" />
</head>
<body style="margin:30px;">
    <div class="page-title">Son Adım</div>
    <div class="page-subtitle">Ödeme</div>

    <div class="odeme-wrapper">

        <div class="siparis-ozet">
            <h3 class="ozet-baslik">Sipariş Özeti</h3>
            @foreach (var item in Model)
            {
                <div class="ozet-urun">
                    <img src="~/Assets/ProductImages/@item.Fotograf" />
                    <div class="ozet-urun-bilgi">
                        <span class="ozet-urun-adi">@item.UrunAdi</span>
                        <span class="ozet-urun-adet">@item.Adet adet</span>
                    </div>
                    <span class="ozet-urun-fiyat">@item.Toplam.ToString("C")</span>
                </div>
            }
            <div class="ozet-separator"></div>
            <div class="ozet-satir ozet-toplam">
                <div>Genel Toplam</div>
                <div>@Model.Sum(x => x.Toplam).ToString("C")</div>
            </div>
        </div>

        @using (Html.BeginForm("Onayla", "Sepet", new { @class = "kart-form" }))
        {
            <h3 class="ozet-baslik">Kart Bilgileri</h3>

            <div class="form-grup">
                <label>Kart Üzerindeki İsim</label>
                <input type="text" name="KartIsim" class="form-input"
                       placeholder="Ad Soyad" />
            </div>

            <div class="form-grup">
                <label>Kart Numarası</label>
                <input type="text" name="KartNo" class="form-input"
                       placeholder="0000 0000 0000 0000" maxlength="16" />
            </div>

            <div class="form-row">
                <div class="form-grup">
                    <label>Son Kullanma Tarihi</label>
                    <input type="text" name="SonKullanma" class="form-input"
                           placeholder="AA / YY" maxlength="4" />
                </div>
                <div class="form-grup">
                    <label>CVV</label>
                    <input type="text" name="Cvv" class="form-input"
                           placeholder="000" maxlength="3" />
                </div>
            </div>

            <button type="submit" class="sepet-btn odeme-btn">Ödemeyi Tamamla</button>

            <a href="@Url.Action("Index", "Sepet")" class="geri-btn">← Sepete Dön</a>
        }

    </div>
</body>
</html>
