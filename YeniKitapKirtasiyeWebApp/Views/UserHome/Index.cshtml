@model IEnumerable<YeniKitapKirtasiyeWebApp.Models.Product>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_UserLayoutPage.cshtml";
}

<div class="page-title">Ürünlerimiz</div>
<div class="page-subtitle">Tüm Ürünler</div>

<div class="urun-grid">
    @foreach (var u in Model)
    {
        <div class="urun-kart">
            <div class="urun-fotograf">
                <img src="~/Assets/ProductImages/@u.ImagePath"
                     alt="@u.Name" />
            </div>
            <div class="urun-bilgi">
                <div class="urun-kategori">@u.category.Name</div>
                <div class="urun-isim">@u.Name</div>
                <div class="urun-fiyat">@u.Price.ToString("C")</div>
                <a href="@Url.Action("Find", "UserProduct", new { id = u.ID })"
                   class="urun-detay-btn">Detayı Gör →</a>
            </div>
        </div>
    }
</div>

