@model YeniKitapKirtasiyeWebApp.Data.ViewModel.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Kayıt Ol</title>
    <link href="~/Assets/Css/Login_SignIn_CSS.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container" style="margin-top:40px;">
        <div class="left-box shadow" style="padding-bottom: 40px;">
            <h1>Create Account</h1>
            <div class="socialContainer">
                <a href="#" class="social"><i class="fab fa-facebook-f"></i></a>
                <a href="#" class="social"><i class="fab fa-google-plus-g"></i></a>
                <a href="#" class="social"><i class="fab fa-linkedin-in"></i></a>
            </div>
            <p>or use email for your registration</p>
            <br />
            @if (Model != null)
            {
                using (Html.BeginForm("Register", "UserAccount"))
                {

                    <div class="box">
                        <input type="text" name="Name" class="textbox"
                               placeholder="Name" value="@Model.Name" />
                    </div>
                    <div class="box">
                        <input type="text" name="Surname" class="textbox"
                               placeholder="Surname" value="@Model.Surname" />
                    </div>
                    <div class="box">
                        <input type="email" name="Mail" class="textbox"
                               placeholder="Email" value="@Model.Mail" />
                    </div>
                    <div class="box">
                        <input type="password" name="Password" class="textbox"
                               placeholder="Password" />
                    </div>
                    <div class="box">
                        <input type="password" name="PasswordAgain" class="textbox"
                               placeholder="Confirm Password" />
                    </div>

                    if (ViewBag.Hata != null)
                    {
                        <div class="warningText">@ViewBag.Hata</div>
                    }

                    <div>
                        <button type="submit" class="button">SIGN UP</button>
                    </div>
                }
            }
            else
            {
                using (Html.BeginForm("Register", "UserAccount"))
                {

                    <div class="box">
                        <input type="text" name="Name" class="textbox"
                               placeholder="Name" />
                    </div>
                    <div class="box">
                        <input type="text" name="Surname" class="textbox"
                               placeholder="Surname" />
                    </div>
                    <div class="box">
                        <input type="email" name="Mail" class="textbox"
                               placeholder="Email" />
                    </div>
                    <div class="box">
                        <input type="password" name="Password" class="textbox"
                               placeholder="Password" />
                    </div>
                    <div class="box">
                        <input type="password" name="PasswordAgain" class="textbox"
                               placeholder="Confirm Password" />
                    </div>

                    if (ViewBag.Hata != null)
                    {
                        <div class="warningText">@ViewBag.Hata</div>
                    }

                    <div>
                        <button type="submit" class="button">SIGN UP</button>
                    </div>
                }
            }
        </div>
    </div>
</body>
</html>
