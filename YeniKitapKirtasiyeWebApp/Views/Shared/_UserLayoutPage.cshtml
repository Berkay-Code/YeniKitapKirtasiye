<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Assets/Css/UserPanel.css" rel="stylesheet" />
</head>
<body>
    <div class="body">
        <div class="sidebar">
            <div class="sidebar-header">
                <div class="header-foto">
                    <img src="~/Assets/Css/Logo.png" />
                </div>
                <a href="@Url.Action("Index", "UserHome")" class="header-logo">Yeni Kitap Kırtasiye</a>
            </div>
            <div class="sidebar-container">
                @Html.Action("Categories", "Sidebar")
                @*@{ Html.RenderAction("_MenuOlustur", "Kategori"); }*@  @*RenderAction ile de oluşturulabilir*@

            </div>
        </div>
        <div class="content">
            <div class="header">
                <div class="header-right">
                    @if (Session["UserName"] != null)
                    {
                        <div class="header-user">Merhaba, @Session["UserName"]</div>
                        <a href="@Url.Action("Index", "Sepet")" class="header-btn header-btn-outline">
                            Sepet (@YeniKitapKirtasiyeWebApp.Data.Helper.SepetHelper.ToplamAdet(Session))
                        </a>
                        @Html.ActionLink("Çıkış", "Logout", "UserAccount", null, new { @class = "header-btn" })
                    }
                    else
                    {
                        @Html.ActionLink("Giriş Yap", "Login", "UserAccount", null, new { @class = "header-btn" })
                        @Html.ActionLink("Kayıt Ol", "Register", "UserAccount", null, new { @class = "header-btn header-btn-outline" })
                    }
                </div>
            </div>
            <div class="content-container">
                @RenderBody()
            </div>
        </div>
    </div>
</body>
</html>