@model IEnumerable<YeniKitapKirtasiyeWebApp.Models.Category>
<div class="sidebar-kategoriler">
    <ul>
        @foreach (var item in Model)
        {
            <li>
                @Html.ActionLink(item.Name, "Find", "UserCategory", new { kategoriID = item.ID }, new { @class = "sidebar-link" })
            </li>
        }
    </ul>
</div>