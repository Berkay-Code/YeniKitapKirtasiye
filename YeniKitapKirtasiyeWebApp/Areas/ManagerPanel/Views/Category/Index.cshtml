@model IEnumerable<YeniKitapKirtasiyeWebApp.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/ManagerPanel/Views/Shared/_LayoutPage.cshtml";
}

<div class="card">
    <div class="card-header">
        <div class="card-title">
            <h3>Kategori Listesi</h3>
            <a href="@Url.Action("Create","Category")" class="title-button"> + Yeni Kategori</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table" cellpadding="0" cellspacing="0">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>
                <th>
                    <label>Seçenekler</label>
                </th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.ID
                    </td>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <label style="color:green">Aktif Kategori</label>
                        }
                        else
                        {
                            <label style="color:red">Pasif Kategori</label>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("Edit","Category",new {id = item.ID})" class="düzenle-button table-button">Düzenle</a> |
                        <a href="@Url.Action("Delete","Category",new {id = item.ID})" class="sil-button table-button">Sil</a>
                    </td>
                </tr>
            }

        </table>

    </div>
    <div class="card-footer">
        <label>@Model.Count() adet Kategori bulunmaktadır</label>
    </div>
</div>

